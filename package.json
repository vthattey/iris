{
  "name": "iris-diagrams",
  "version": "0.1.0",
  "description": "Interactive UML and ER diagrams that open collapsed and expand one level per click. Offline single-file HTML output, Mermaid export, CLI and Agent Skill.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "iris": "bin/iris.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "viewer",
    "schema",
    "skill",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/",
    "examples": "node scripts/build-examples.js"
  },
  "keywords": [
    "uml",
    "er-diagram",
    "class-diagram",
    "sequence-diagram",
    "interactive",
    "diagram",
    "mermaid",
    "agent-skill"
  ],
  "dependencies": {
    "ajv": "8.17.1",
    "elkjs": "0.11.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.7"
  }
}
