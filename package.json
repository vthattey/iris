{
  "name": "iris-diagrams",
  "version": "0.1.0",
  "description": "Interactive UML and ER diagrams that open collapsed and expand one level per click. Offline single-file HTML output, Mermaid export, CLI and Agent Skill.",
  "type": "module",
  "license": "MIT",
  "author": "Vikas (https://github.com/vthattey)",
  "homepage": "https://github.com/vthattey/iris#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vthattey/iris.git"
  },
  "bugs": {
    "url": "https://github.com/vthattey/iris/issues"
  },
  "bin": {
    "iris": "bin/iris.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./analyze": "./src/analyze/index.js",
    "./import": "./src/import/index.js",
    "./schema": "./schema/iris-diagram.schema.json"
  },
  "files": [
    "bin",
    "src",
    "viewer",
    "schema",
    "skill",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "examples": "node scripts/build-examples.js",
    "docs:images": "npm run examples && node scripts/capture-docs.cjs"
  },
  "keywords": [
    "uml",
    "er-diagram",
    "class-diagram",
    "sequence-diagram",
    "activity-diagram",
    "state-diagram",
    "component-diagram",
    "interactive",
    "diagram",
    "architecture",
    "code-visualization",
    "static-analysis",
    "java",
    "spring",
    "typescript",
    "python",
    "plantuml",
    "mermaid",
    "agent-skill",
    "copilot",
    "claude-code"
  ],
  "dependencies": {
    "ajv": "8.17.1",
    "elkjs": "0.11.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.7"
  }
}
