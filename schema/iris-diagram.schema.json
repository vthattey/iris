{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iris-diagrams.dev/schema/iris-diagram-1.0.json",
  "title": "Iris diagram document",
  "description": "One file holds one or more diagrams. Hierarchy (parent) and members drive expand-one-level-per-click: everything with children or members opens collapsed.",
  "type": "object",
  "required": ["iris", "diagrams"],
  "additionalProperties": false,
  "properties": {
    "iris": { "const": "1.0", "description": "Schema version" },
    "title": { "type": "string", "description": "Document title shown in the sidebar" },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/diagram" }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:$/#@\\-]+$", "minLength": 1 },
    "source": {
      "type": "object",
      "description": "Where this element comes from in the code base",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "member": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["field", "method", "constructor", "column", "literal"], "description": "literal = enum constant" },
        "type": { "type": "string", "description": "Field/column type or method return type" },
        "params": { "type": "string", "description": "Method parameter list, e.g. \"PaymentDTO request\"" },
        "visibility": { "enum": ["public", "private", "protected", "package"] },
        "static": { "type": "boolean" },
        "abstract": { "type": "boolean" },
        "pk": { "type": "boolean", "description": "ER: primary key column" },
        "fk": { "type": "string", "description": "ER: referenced column, e.g. accounts.id" },
        "nullable": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string", "description": "Display name; defaults to id" },
        "kind": {
          "type": "string",
          "description": "Allowed values depend on diagram type: class: package|class|interface|abstract|enum|record|annotation. component: system|container|component|database|queue|external|actor|node. activity: start|end|action|decision|merge|fork|join|subflow|note. state: initial|final|state|composite|choice|history. er: schema|table|view."
        },
        "parent": { "$ref": "#/definitions/id", "description": "Containing element. Children stay hidden until the parent is clicked." },
        "stereotype": { "type": "string" },
        "members": { "type": "array", "items": { "$ref": "#/definitions/member" } },
        "note": { "type": "string" },
        "source": { "$ref": "#/definitions/source" },
        "expanded": { "type": "boolean", "description": "Start expanded instead of collapsed" }
      }
    },
    "relation": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "kind": {
          "type": "string",
          "description": "class: inheritance|realization|association|aggregation|composition|dependency. component: uses|calls|reads|writes|publishes|subscribes. activity: flow. state: transition. er: relationship."
        },
        "label": { "type": "string", "description": "Guard, event, method name or relationship name" },
        "fromCard": { "type": "string", "description": "Multiplicity at the from end: 1, 0..1, *, 1..*" },
        "toCard": { "type": "string", "description": "Multiplicity at the to end" }
      }
    },
    "participant": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "label": { "type": "string" },
        "kind": { "enum": ["participant", "actor", "boundary", "control", "entity", "database", "queue", "external"] },
        "source": { "$ref": "#/definitions/source" }
      }
    },
    "message": {
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/definitions/id" },
        "to": { "$ref": "#/definitions/id" },
        "label": { "type": "string" },
        "kind": { "enum": ["sync", "async", "reply", "create"], "default": "sync" },
        "note": { "type": "string" },
        "source": { "$ref": "#/definitions/source" },
        "expanded": { "type": "boolean" },
        "children": {
          "type": "array",
          "description": "Calls made while handling this message. Hidden until the message is clicked.",
          "items": { "$ref": "#/definitions/message" }
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "enum": ["class", "sequence", "activity", "component", "state", "er"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "direction": { "enum": ["DOWN", "RIGHT", "UP", "LEFT"], "description": "Main layout direction for graph diagrams" },
        "elements": { "type": "array", "items": { "$ref": "#/definitions/element" } },
        "relations": { "type": "array", "items": { "$ref": "#/definitions/relation" } },
        "participants": { "type": "array", "items": { "$ref": "#/definitions/participant" } },
        "messages": { "type": "array", "items": { "$ref": "#/definitions/message" } }
      },
      "if": { "properties": { "type": { "const": "sequence" } } },
      "then": { "required": ["participants", "messages"] },
      "else": { "required": ["elements"] }
    }
  }
}
